<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chances.shell">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        WebActivity 把用户在设置弹框输入的 webUrl 持久化到 /sdcard/web_url.txt，需外部存储读写权限。
        入口 LauncherActivity 通过 chances.core.permission.PermissionHelper 统一申请，Android 6.0+ 即拿即用；
        权限被拒时降级为不读写 sdcard，仅 Intent / 默认地址通道，不影响页面运行。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- TV 设备：声明非触摸屏与 leanback -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".OttApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- 统一入口（管理中心）：申请权限后跳 WebActivity -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView 业务页：url 优先取 Intent EXTRA_URL，缺失回退 sdcard，再回退 BuildConfig.H5_URL；连按 5 次菜单键弹设置 -->
        <activity
            android:name=".web.WebActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />
    </application>
</manifest>
