{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@shell/core": ["packages/core/src/index.ts"],
      "@shell/core/*": ["packages/core/src/*"],
      "@shell/ui": ["packages/ui/src/index.ts"],
      "@shell/ui/*": ["packages/ui/src/*"],
      "@shell/feature-aichat": ["packages/features/aichat/src/index.ts"]
    }
  }
}
